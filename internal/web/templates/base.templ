package templates

css bodyStyle() {
	font-family: "Lexend", sans-serif;
	background-image: url("https://files.catbox.moe/dvoz2e.jpg");
	color: #cdd6f4;
	margin: 0;
	min-height: 100vh;
	display: flex;
	flex-direction: column;
}

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link href="https://api.fonts.coollabs.io/css2?family=Creepster&family=Lexend&display=swap" rel="stylesheet"/>
			<link rel="icon" type="image/x-icon" href="e"/>
			<title>camera</title>
		</head>
		<body class={ bodyStyle() }>
			{ children... }
		</body>
	</html>
}
